rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated (admin)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "induwara1203@gmail.com";
    }

    // Config collection holds hotel information
    match /config/hotelInfo {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories for the gallery
    match /categories/{category} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gallery images metadata
    match /galleryItems/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Booking inquiries
    match /inquiries/{inquiry} {
      allow create: if true; // anyone can submit an inquiry
      allow read, update, delete: if isAdmin();
    }
  }
}
